{
  "manifest_version": 3,
  "name": "Red Wed QC Helper",
  "version": "1.2.0",
  "description": "Runs AutoCheck for the Red Wed Studio Ops QC dashboard: checks V2 against V1's Frame.io comments and posts [AutoCheck] comments.",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": [
    "https://next.frame.io/*", "https://f.io/*", "https://*.frame.io/*",
    "https://redwed.in/*", "https://*.redwed.in/*", "https://*.onrender.com/*",
    "http://127.0.0.1/*", "http://localhost/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://redwed.in/*", "https://*.redwed.in/*", "https://*.onrender.com/*",
                "http://127.0.0.1/*", "http://localhost/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }],
  "action": {"default_title": "Red Wed QC Helper", "default_popup": "popup.html"},
  "icons": {"128": "icon128.png"}
}
